# Mobile app -> your FieldIQ backend (never put a paid sports API key here)
EXPO_PUBLIC_FIELD_IQ_API_URL=http://localhost:8000

# Used by the official NWS API User-Agent in the daily collector
FIELDIQ_CONTACT_EMAIL=you@example.com

# Server-only SMS credentials. Never expose these as EXPO_PUBLIC_* variables.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
